EDUCLOUD_COURSE_DB_PASSWORD=LocalCourseApp_ChangeMe_2026
EDUCLOUD_COURSE_MIGRATION_PASSWORD=LocalCourseMigration_ChangeMe_2026
EDUCLOUD_CONTENT_DB_PASSWORD=LocalContentApp_ChangeMe_2026
EDUCLOUD_CONTENT_MIGRATION_PASSWORD=LocalContentMigration_ChangeMe_2026
