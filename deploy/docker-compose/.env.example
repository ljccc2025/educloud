EDUCLOUD_PAYMENT_DB_PASSWORD=LocalPaymentApp_ChangeMe_2026
EDUCLOUD_PAYMENT_MIGRATION_PASSWORD=LocalPaymentMigration_ChangeMe_2026
EDUCLOUD_LIVE_DB_PASSWORD=LocalLiveApp_ChangeMe_2026
EDUCLOUD_LIVE_MIGRATION_PASSWORD=LocalLiveMigration_ChangeMe_2026
# M04 educloud-file：应用/迁移账号密码（16-128 位，字符集同其他服务，见 mysql/init/001-create-databases.sh 校验）
EDUCLOUD_FILE_DB_PASSWORD=LocalFileApp_ChangeMe_2026
EDUCLOUD_FILE_MIGRATION_PASSWORD=LocalFileMigration_ChangeMe_2026
EDUCLOUD_NOTIFICATION_DB_PASSWORD=LocalNotificationApp_ChangeMe_2026
EDUCLOUD_NOTIFICATION_MIGRATION_PASSWORD=LocalNotificationMigration_ChangeMe_2026
EDUCLOUD_ANALYTICS_DB_PASSWORD=LocalAnalyticsApp_ChangeMe_2026
EDUCLOUD_ANALYTICS_MIGRATION_PASSWORD=LocalAnalyticsMigration_ChangeMe_2026
EDUCLOUD_SEARCH_DB_PASSWORD=LocalSearchApp_ChangeMe_2026
EDUCLOUD_SEARCH_MIGRATION_PASSWORD=LocalSearchMigration_ChangeMe_2026
EDUCLOUD_RECOMMENDATION_DB_PASSWORD=LocalRecommendationApp_ChangeMe_2026
EDUCLOUD_RECOMMENDATION_MIGRATION_PASSWORD=LocalRecommendationMigration_ChangeMe_2026

REDIS_PORT=6379
REDIS_PASSWORD=LocalRedis_ChangeMe_2026

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=educloud_local
RABBITMQ_DEFAULT_PASS=LocalRabbitMq_ChangeMe_2026
RABBITMQ_DEFAULT_VHOST=educloud

NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_TLS_PORT=9849
NACOS_AUTH_IDENTITY_KEY=educloud-local-server
NACOS_AUTH_IDENTITY_VALUE=LocalNacosIdentity_ChangeMe_2026
NACOS_AUTH_TOKEN=VGhpc0lzQURldmVsb3BtZW50T25seVNlY3JldEtleTEyMzQ1Njc4OTA=
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m

NACOS_GATEWAY_NAMESPACE=educloud-local
NACOS_GATEWAY_CONFIG_GROUP=EDUCLOUD_GATEWAY
NACOS_GATEWAY_DISCOVERY_GROUP=EDUCLOUD_SERVICES
NACOS_GATEWAY_USERNAME=educloud_gateway
NACOS_GATEWAY_PASSWORD=LocalNacosGateway_ChangeMe_2026

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=educloud_local_admin
MINIO_ROOT_PASSWORD=LocalMinio_ChangeMe_2026

ELASTICSEARCH_HTTP_PORT=9200
ELASTICSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

ZIPKIN_PORT=9411
PROMETHEUS_PORT=9090

GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=educloud_local_admin
GF_SECURITY_ADMIN_PASSWORD=LocalGrafana_ChangeMe_2026
# --- M03 educloud-user ---
NACOS_USER_NAMESPACE=educloud-local
NACOS_USER_USERNAME=educloud_user
NACOS_USER_PASSWORD=LocalNacosUser_ChangeMe_2026
EDUCLOUD_USER_NACOS_USERNAME=educloud_user
EDUCLOUD_USER_NACOS_PASSWORD=LocalNacosUser_ChangeMe_2026
EDUCLOUD_USER_JWT_ISSUER=https://issuer.educloud.local
EDUCLOUD_USER_JWT_AUDIENCE=educloud-api
EDUCLOUD_ENVIRONMENT=local
USER_PORT=8082
EDUCLOUD_USER_IMAGE=educloud-user:local
USER_JWT_PRIVATE_KEY_HOST=../secrets/user-jwt-private.pem

# --- M04 educloud-file ---
# File 内部接口 bootstrap 密钥（占位）：需替换为随机值，与 bootstrap-service-clients.sh 的 BOOTSTRAP_KEY 一致。
EDUCLOUD_FILE_INTERNAL_BOOTSTRAP_KEY=LocalFileInternalBootstrap_ChangeMe_2026
EDUCLOUD_FILE_INTERNAL_ALLOWED_CLIENT_IDS=user-service
EDUCLOUD_FILE_INTERNAL_AUDIENCE=educloud-file
# File 服务 MinIO 配置：本地开发留空即回退 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD；生产用独立最小权限凭据。
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 浏览器直传 MinIO presigned PUT 的 CORS 白名单（逗号分隔；按实际前端 Origin 配置，如 http://192.168.100.136:5173,...）
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
EDUCLOUD_FILE_BUCKET=educloud-files
# User 服务调用 File 内部接口：CLIENT_SECRET 必须与 bootstrap 到 File 的 user-service 客户端 secret 一致。
EDUCLOUD_USER_FILE_ENDPOINT=http://127.0.0.1:8087
EDUCLOUD_USER_FILE_CLIENT_ID=user-service
EDUCLOUD_USER_FILE_CLIENT_SECRET=
# File 服务 Nacos 身份（provision-file-nacos.sh 创建；start-dev.sh 用 NACOS_FILE_PASSWORD 登录）。
NACOS_FILE_USERNAME=educloud_file
NACOS_FILE_PASSWORD=LocalNacosFile_ChangeMe_2026

